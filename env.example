# Email (Gmail via nodemailer) -- used for welcome emails, top-up
# confirmations, and the "Send test notification" button.
# EMAIL_USER is a Gmail address. EMAIL_APP_PASSWORD is a 16-character
# App Password, NOT your normal Gmail password -- turn on 2-Step
# Verification on that Google account first, then generate one at
# https://myaccount.google.com/apppasswords
# Leave both blank to skip email entirely (server logs instead of sending).
EMAIL_USER=
EMAIL_APP_PASSWORD=
